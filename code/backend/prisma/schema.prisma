// CampusLink data model.
//
// This file is the executable version of the class diagram in the UML document
// (User / Goal / Request / Lobby), extended with the entities the trust & safety layer needs.
//
// PORTABILITY NOTE — read before adding fields:
// Development runs on SQLite (no local Postgres or Docker on the team's machines); production
// runs on managed PostgreSQL. Prisma does not support native `enum` blocks on SQLite, so every
// enumerated column here is a `String` whose allowed values live in `packages/shared/src/enums.js`
// and are enforced by Zod at the API boundary. That keeps this schema byte-identical across both
// databases — switching is a one-line change to `provider` plus the DATABASE_URL env var.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Models are introduced feature by feature, alongside the endpoints that use them:
//   Step 1 — User, OtpToken   (below)
//   Step 3 — Goal
//   Step 4 — JoinRequest
//   Step 5 — no new models: the lobby of the class diagram is a Goal plus its accepted
//            JoinRequests, so its lifecycle lives in Goal.status. See src/domain/goal.ts.
//   Step 6 — Message
//   Step 8 — Report, Block, AuditLog
//   Step 9 — Rating

/// A verified member of the campus. Every other entity hangs off this one.
model User {
  id String @id @default(cuid())

  // --- Identity ---
  /// Always stored lowercased. Restricted to the college domain at the API boundary, which is
  /// what keeps the platform to actual students (proposal §3.3).
  email        String @unique
  passwordHash String
  name         String

  // --- Verification ---
  /// False until the emailed OTP is confirmed. Unverified users cannot post or request.
  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  // --- Profile (filled out in Step 2) ---
  branch         String?
  /// Year of study, 1-5.
  year           Int?
  /// One of GENDER in packages/shared/src/enums.js. Drives the gender-preference filter.
  gender         String    @default("UNDISCLOSED")
  /// Avatar bytes, base64-encoded, with its media type.
  ///
  /// Deliberately never included in any DTO — it is served by GET /users/:id/photo instead. A
  /// feed of twenty goal cards would otherwise carry twenty inlined images in one JSON payload.
  /// Serving it separately also lets the browser cache it, and `photoUpdatedAt` provides the
  /// cache-buster so a newly uploaded photo appears immediately.
  ///
  /// Stored in the database rather than on disk because free-tier hosting has an ephemeral
  /// filesystem — an uploaded avatar would vanish on the next deploy. Step 7 introduces real
  /// object storage for notes; avatars can move there behind the same interface.
  photoData      String?
  photoMimeType  String?
  photoUpdatedAt DateTime?
  /// Comma-separated interest tags. SQLite has no array type, so the API splits and joins it;
  /// this becomes a native String[] if and when the project moves to PostgreSQL only.
  interests      String    @default("")

  // --- Trust & safety ---
  /// One of USER_ROLE in packages/shared/src/enums.js.
  role             String @default("STUDENT")
  /// All three are denormalised rather than derived on every read, because reliability is
  /// rendered on every single feed card, every roster row and every chat bubble.
  ///
  /// They are **recomputed from scratch** by `recomputeReliability` whenever a goal completes or
  /// a rating lands — never incremented in place. A verdict can flip as more of a group votes, so
  /// a counter nudged up and down would drift out of agreement with the ratings behind it, and
  /// nothing would ever notice. Recomputing is idempotent; incrementing is not.
  ///
  ///   goalsCompleted   finished goals this student actually turned up to
  ///   noShowCount      finished goals the group said they did not
  ///   reliabilityScore derived from the two by src/domain/reliability.ts
  reliabilityScore Int    @default(100)
  goalsCompleted   Int    @default(0)
  noShowCount      Int    @default(0)

  postedGoals     Goal[]        @relation("PostedGoals")
  joinRequests    JoinRequest[]
  messages        Message[]
  /// Answers this student gave about other people, and answers other people gave about them.
  ratingsGiven    Rating[]      @relation("RatingsGiven")
  ratingsReceived Rating[]      @relation("RatingsReceived")

  /// Trust and safety (Step 8). Reports this student filed, reports about them, reports they
  /// reviewed as an admin, blocks in both directions, and the audit trail of their admin acts.
  reportsFiled    Report[]   @relation("ReportsFiled")
  reportsAgainst  Report[]   @relation("ReportsAgainst")
  reportsReviewed Report[]   @relation("ReportsReviewed")
  blocksMade      Block[]    @relation("BlocksMade")
  blocksReceived  Block[]    @relation("BlocksReceived")
  auditEntries    AuditLog[] @relation("AuditActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

/// A one-time passcode emailed during signup.
///
/// Only the hash of the code is stored — a leaked database should not let anyone verify as
/// somebody else. Rows are single-use (`consumedAt`) and short-lived (`expiresAt`).
model OtpToken {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  purpose    String    @default("SIGNUP")
  expiresAt  DateTime
  consumedAt DateTime?
  /// Guards against brute-forcing a 6-digit code.
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email, purpose])
}

/// An activity a student needs other people for. The centre of the whole product.
model Goal {
  id String @id @default(cuid())

  posterId String
  poster   User   @relation("PostedGoals", fields: [posterId], references: [id], onDelete: Cascade)

  /// One of GOAL_CATEGORY in packages/shared/src/enums.js.
  category    String
  title       String
  description String

  /// When the activity happens. Null for "whenever" goals, which expire on `expiresAt` instead.
  dateTime DateTime?

  /// How many people the poster needs to JOIN, not counting themselves. A gym partner is 1.
  headcount Int

  /// How many accepted members the lobby currently has. Denormalised because every feed card
  /// renders "2 of 3 joined", and counting requests per card would be a query per row.
  acceptedCount Int @default(0)

  // --- Trust & safety (proposal §3.3) ---
  /// Hides the poster's name and photo on the feed. Reliability score stays visible, and identity
  /// is revealed to a requester once they are accepted. Enforced in the serializer, never the UI.
  anonymous        Boolean @default(false)
  /// One of GENDER_PREFERENCE. Restricts who may request to join.
  genderPreference String  @default("ANY")
  /// Skip manual approval and accept requests automatically until the headcount is met.
  autoAccept       Boolean @default(false)

  /// One of GOAL_STATUS.
  status String @default("OPEN")

  /// When an undated goal stops accepting requests. The proposal's fulfilment metric uses the
  /// goal's own date/time, or 48 hours for undated ones.
  expiresAt DateTime?

  requests JoinRequest[]
  messages Message[]
  ratings  Rating[]
  reports  Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The feed is ordered newest-first and filtered by category and date, so those are indexed —
  // this is the "paginated and indexed" claim in §6 of the proposal.
  @@index([status, createdAt])
  @@index([status, category])
  @@index([dateTime])
  @@index([posterId])
}

/// A student asking to join somebody else's goal. The state machine at the centre of Step 4.
///
/// Named JoinRequest rather than Request, as the class diagram has it: Prisma generates a type per
/// model, and `Request` would collide with Express's `Request`, which every controller imports.
model JoinRequest {
  id String @id @default(cuid())

  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  requesterId String
  requester   User   @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  /// One of REQUEST_STATUS. The legal moves between them are defined in
  /// src/domain/joinRequest.ts and nowhere else.
  status String @default("PENDING")

  /// An optional note to the poster.
  message String @default("")

  /// When the poster accepted or declined, or the student withdrew. Null while pending.
  decidedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per student per goal. Withdrawing and asking again reopens the same row, which is
  /// also what stops a declined student from simply submitting a fresh request.
  @@unique([goalId, requesterId])
  @@index([goalId, status])
  @@index([requesterId])
}

/// One message in a lobby's group chat.
///
/// Hangs off the Goal rather than off a Lobby, for the same reason Step 5 added no Lobby table:
/// the lobby *is* the goal plus its accepted members, so the goal is what a message belongs to.
/// Who may read or write one is not stored here — it is `canViewLobby` in src/domain/goal.ts,
/// asked fresh on every read, every send and every socket join. Caching membership on the message
/// would mean someone who left the group kept the access they had when they sent it.
model Message {
  id String @id @default(cuid())

  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  body String

  /// One of MESSAGE_KIND. USER is somebody typing; SYSTEM is the app reporting a change to the
  /// goal — a new time, for instance — so the group finds out in the place they are already
  /// looking rather than by turning up at the wrong hour. A system line still carries a sender,
  /// because it is always the result of something a particular person did.
  kind String @default("USER")

  createdAt DateTime @default(now())

  /// The chat is read newest-first and paged backwards, which is exactly this index. There is no
  /// updatedAt: a message is never edited, so the history two people remember cannot be rewritten
  /// under them. Deleting one is a moderation action and belongs with the report flow in Step 8.
  @@index([goalId, createdAt])
}

/// One student's answer to "did this person turn up?", for one finished goal.
///
/// Attendance, deliberately, and not a star rating. A five-point scale between people who will
/// see each other in the canteen tomorrow collects politeness, not information — everyone gives
/// four. Whether somebody came is a fact, it is the thing "reliability" is actually claiming, and
/// it is what the proposal's no-show flagging needs.
///
/// One row per rater per subject per goal, so nobody can vote twice. A rating is never edited:
/// what you said about somebody stands, which is also what stops a retaliatory change after you
/// see what they said about you.
model Rating {
  id String @id @default(cuid())

  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  /// Who is answering. Must have been in the lobby themselves.
  raterId String
  rater   User   @relation("RatingsGiven", fields: [raterId], references: [id], onDelete: Cascade)

  /// Who they are answering about. Must also have been in the lobby, and never themselves.
  subjectId String
  subject   User   @relation("RatingsReceived", fields: [subjectId], references: [id], onDelete: Cascade)

  /// True for "turned up". The verdict for a goal is the majority of these, not any single one —
  /// see `isAbsentByVote` in src/domain/reliability.ts.
  attended Boolean

  createdAt DateTime @default(now())

  @@unique([goalId, raterId, subjectId])
  @@index([subjectId])
  @@index([goalId])
}

/// A student telling the admins that somebody is a problem.
///
/// The report names a **user**, not a post, even when it was filed from a goal or a message. That
/// is the question an admin actually has to answer — is this person a problem — and it is the only
/// framing that works for an anonymous goal, where the reporter cannot know who they are reporting.
/// The server resolves the subject from the goal; the reporter never learns the name.
///
/// `goalId` and `messageId` are context, kept so an admin can see what prompted it. Both are
/// optional and both survive the thing they point at being removed, which is why neither is a
/// foreign key with a cascade — a report whose evidence vanished is still a report.
model Report {
  id String @id @default(cuid())

  reporterId String
  reporter   User   @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)

  /// The student being reported. Resolved server-side, never sent by the client.
  subjectId String
  subject   User   @relation("ReportsAgainst", fields: [subjectId], references: [id], onDelete: Cascade)

  /// What prompted it. Null when somebody is reported from their profile.
  goalId    String?
  goal      Goal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)
  /// Deliberately not a relation: a message deleted in moderation must not take the report with it.
  messageId String?

  /// One of REPORT_REASON.
  reason String
  detail String @default("")

  /// One of REPORT_STATUS.
  status       String    @default("OPEN")
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("ReportsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One open report per reporter per subject: a student can report somebody again after it has
  /// been dealt with, but cannot file the same complaint fifty times to bury the queue.
  @@index([subjectId])
  @@index([status, createdAt])
  @@index([reporterId])
}

/// One student choosing not to see another.
///
/// Stored one-way — who blocked whom — but enforced both ways. If it were read one-way, the person
/// who was blocked could still see the blocker's goals and ask to join them, which is the opposite
/// of what blocking is for. See `blockedUserIds` in src/modules/safety/blocks.service.ts.
model Block {
  id String @id @default(cuid())

  blockerId String
  blocker   User   @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)

  blockedId String
  blocked   User   @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// A permanent record of an admin doing something only an admin can do.
///
/// Append-only: there is no update and no delete anywhere in the codebase, and no endpoint that
/// could reach one. That is the entire point. Anonymous posting is a promise made to students,
/// and the only thing that keeps such a promise honest is that breaking it leaves a mark the
/// person who broke it cannot rub out.
model AuditLog {
  id String @id @default(cuid())

  actorId String
  actor   User   @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  /// One of AUDIT_ACTION.
  action String

  /// What was acted on — "Goal", "Report", "User" — and its id.
  targetType String
  targetId   String

  /// Human-readable context, written at the time. Never recomputed, because the point of a log is
  /// what was true then, not what is true now.
  detail String @default("")

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
