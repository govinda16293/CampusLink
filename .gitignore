# ---- OS / editor ----------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- Python / MkDocs (the docs site) --------------------------------------------------------
.venv/
venv/
__pycache__/
.pytest_cache/
site/
*.egg-info/

# ---- Node (the application, under code/) ----------------------------------------------------
node_modules/
dist/
build/
coverage/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-lock.yaml
*.log

# ---- Secrets — never commit these -----------------------------------------------------------
# SMTP credentials for the OTP mailer live here. .env.example is the documented template and is
# the only one of these that belongs in the repository.
.env
.env.*
!.env.example

# ---- Local SQLite database ------------------------------------------------------------------
# Development runs on a local file; it holds real verified accounts and password hashes, and it
# is recreated by `npm run db:push`.
*.db
*.db-journal
*.sqlite
code/backend/prisma/*.db*

# ---- Uploads (local file-storage adapter) ---------------------------------------------------
code/backend/uploads/

# ---- Per-developer tooling ------------------------------------------------------------------
# .claude/settings.json is shared with the team; settings.local.json is personal.
.claude/settings.local.json

# ---- Scratch folder for design uploads ------------------------------------------------------
# Anything the app actually uses is copied into code/frontend/src/assets/ and committed from
# there, so the original drop stays local.
input/
