# Copy to .env and adjust. Never commit .env itself.

# --- Server ---
NODE_ENV=development
PORT=4000
# Origin(s) allowed to call the API, comma-separated.
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# Development: SQLite file, no install required.
DATABASE_URL="file:./dev.db"
# Production: managed PostgreSQL (Neon / Supabase). Also flip `provider` in prisma/schema.prisma.
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth ---
# Must be at least 16 characters. Generate a real one for deployment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-before-deploying
JWT_EXPIRES_IN=7d

# --- Email / OTP ---
# console = print the passcode to the terminal (no credentials needed)
# smtp    = send real email
MAIL_TRANSPORT=console
MAIL_FROM="CampusLink <no-reply@campuslink.local>"

# --- SMTP (only needed when MAIL_TRANSPORT=smtp) ---
# The server refuses to start if MAIL_TRANSPORT=smtp and any of HOST/USER/PASS is missing,
# so a misconfiguration can never look like "signup worked but no email arrived".
#
# GMAIL (easiest — works with a personal Gmail or a thapar.edu Google account):
#   1. Enable 2-Step Verification: https://myaccount.google.com/signinoptions/two-step-verification
#      (App Passwords do not exist as an option until 2FA is on.)
#   2. Create an App Password:    https://myaccount.google.com/apppasswords
#      Name it "CampusLink". Google shows a 16-character password like "abcd efgh ijkl mnop".
#   3. Paste it below WITHOUT the spaces, and set MAIL_TRANSPORT=smtp above.
#   Your normal Google password will NOT work here — it must be an App Password.
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=abcdefghijklmnop
# MAIL_FROM="CampusLink <yourname@gmail.com>"
#
# Note: MAIL_FROM should match SMTP_USER. Gmail rewrites a mismatched From anyway, and other
# providers reject the message outright.
#
# Other providers (same class, different values):
#   Brevo     smtp-relay.brevo.com:587      Outlook  smtp-mail.outlook.com:587
#   SendGrid  smtp.sendgrid.net:587         Mailtrap sandbox.smtp.mailtrap.io:2525
# Port 465 instead of 587 means SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
