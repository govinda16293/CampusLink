# Copy to .env and adjust. Never commit .env itself.

# --- Server ---
NODE_ENV=development
PORT=4000
# Origin(s) allowed to call the API, comma-separated.
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# Development: SQLite file, no install required.
DATABASE_URL="file:./dev.db"
# Production: managed PostgreSQL (Neon / Supabase). Also flip `provider` in prisma/schema.prisma.
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth (used from Step 1 onward) ---
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=7d

# --- Email / OTP (used from Step 1 onward) ---
# console = print the OTP to the terminal instead of sending mail. Use for development.
MAIL_TRANSPORT=console
